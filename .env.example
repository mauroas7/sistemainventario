APP_NAME="Ticketera de Bienes - Hospital Universitario"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# La IP del proxy que hace el HTTPS, tal como la ve la aplicación (no siempre
# la del proxy: en Docker puede ser la de su red). Separadas por coma, acepta
# rangos. Vacío en desarrollo, donde nadie se interpone.
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistemabienes
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en producción, detrás del HTTPS: la cookie de sesión no viaja por http.
# Vacío en desarrollo, donde se entra por http.
SESSION_SECURE_COOKIE=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# log: los mails se escriben en storage/logs/laravel.log en vez de enviarse.
# En el hospital, el mismo relay que portal-hospital: MAIL_MAILER=smtp, MAIL_HOST y
# MAIL_PORT del relay y MAIL_VERIFY_PEER=false. Usuario y clave van sólo en el .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_VERIFY_PEER=true
MAIL_TIMEOUT=10
# Tiene que ser una casilla institucional: el valor probatorio del aviso depende de eso.
MAIL_FROM_ADDRESS="patrimonio@hospital.test"
MAIL_FROM_NAME="${APP_NAME}"

# Casillas de Gestion de Bienes que reciben el aviso de cada movimiento informado.
# Se aceptan varias separadas por coma. Si queda vacio, se avisa a los usuarios admin.
PATRIMONIO_NOTIFICACIONES_EMAIL=

VITE_APP_NAME="${APP_NAME}"
